+  }
+  const weatherArea = createArea({
+    id: "weather",
+    areaLabel: "Weather",
+    signals: weatherSignals,
+  });
+  if (weatherArea) {
+    areas.push(weatherArea);
+  } else {
+    healthyAreas.push(createHealthyArea("Weather remains healthy."));
+  }
+
+  const mobilitySignals = [];
