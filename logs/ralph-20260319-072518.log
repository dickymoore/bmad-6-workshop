import assert from "node:assert/strict";
import test from "node:test";

const describeStack = [];

function withPrefix(name) {
  return [...describeStack, name].join(" > ");
}

export function describe(name, fn) {
  describeStack.push(name);

  try {
    fn();
  } finally {
    describeStack.pop();
  }
}

export function it(name, fn) {
