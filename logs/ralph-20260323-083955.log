+  gap: 8px;
+  padding: 14px 16px 14px 20px;
+  border-radius: 18px;
+  background:
+    linear-gradient(180deg, rgba(255, 255, 255, 0.78), rgba(244, 239, 230, 0.94)),
+    rgba(255, 255, 255, 0.74);
+}
