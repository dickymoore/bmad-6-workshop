+
+  assert.equal(/data-live-shell="stable"|data-reading-zone="header"|data-reading-zone="modes"|data-reading-zone="map"/.test(screen), true, "stable reading-order hooks should stay explicit in the public shell");
+  assert.equal(/useRef<DashboardApiResponse\["data"\]\s*\|\s*null>|previousSnapshotRef/.test(liveScreen), true, "live boundary should compare against the previous snapshot instead of remounting the shell");
+  assert.equal(/placeholderData:\s*\(previousData\)\s*=>\s*previousData\s*\?\?\s*initialData|refetchIntervalInBackground:\s*true/.test(hook), true, "query hook should preserve the existing shell during background refresh");
