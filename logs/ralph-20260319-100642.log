+                    <dt>Snapshot</dt>
+                    <dd>{viewModel.snapshotLabel}</dd>
+                  </div>
+                  <div>
+                    <dt>Published</dt>
+                    <dd>{viewModel.publishedAt}</dd>
+                  </div>
+                </dl>
+              </div>
