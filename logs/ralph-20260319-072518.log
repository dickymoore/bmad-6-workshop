+      detail: `${affectedLabels} ${affectedModes.length === 1 ? "is" : "are"} under the most strain nearby while the rest of the departure picture stays readable.`,
+      affectedModeKeys: affectedModes.map((mode) => mode.key),
+    };
+  }
+
+  return {
