+        );
+      }
+
+      const normalizedKey = key.trim();
+
+      if (!knownModeKeys.has(normalizedKey)) {
+        throw new Error(`Dashboard disruption emphasis key "${normalizedKey}" must exist in nearbyModes`);
+      }
+
+      if (seenKeys.has(normalizedKey)) {
