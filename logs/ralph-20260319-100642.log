+      throw new Error(`Dashboard API response "meta.recovery.${fieldName}" must be a valid ISO timestamp when present`);
+    }
+  }
+
+  return freezeRecord({
+    phase,
+    recoveredAt: recoveredAt ?? null,
+    recoverySource,
+    livePublicationResumed,
+    resumedAt: resumedAt ?? null,
+  });
+}
