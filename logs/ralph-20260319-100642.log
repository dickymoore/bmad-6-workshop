check('fallback check status', payload.checks.find((c)=>c.id==='main-layout')?.status === 'attention', payload.checks);
check('fallback issue', payload.issues.includes('The main public layout is incomplete in this read.'), payload.issues);

payload = await getOpsHealthPayload({ getDashboardResponse: async ()=> { throw new Error('TfL token secret stack trace'); }});
check('raw failures hidden', JSON.stringify(payload.issues) === JSON.stringify(['Live readiness could not be confirmed from this local surface.']), payload.issues);

let response = await createOpsHealthRouteResponse({ requestHeaders:new Headers([['host','example.com']]) });
