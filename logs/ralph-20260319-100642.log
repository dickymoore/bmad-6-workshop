check('non-local empty', await response.text() === '', await response.text());

response = await createOpsHealthRouteResponse({ requestHeaders:new Headers([['host','localhost:3000']]), getOpsHealth: async ()=> ({ readiness:{state:'current',label:'Current',summary:'Public display is current and ready for service.'}, checks:[{id:'main-layout', label:'Main layout is present', status:'pass', detail:'The main public layout is visible.'}], issues:[], diagnostics:{ summary:'No degraded areas are narrowing the public picture.', affectedAreas:[], healthyAreas:['Weather remains healthy.'] }, evidence:{ snapshotState:'live', publishedAt:'2026-03-19T08:00:00.000Z' } }) });
let routePayload = await response.json();
check('local response status', response.status===200, response.status);
check('cache-control', response.headers.get('Cache-Control') === 'no-store, max-age=0', response.headers.get('Cache-Control'));
check('vary', response.headers.get('Vary') === 'host, x-forwarded-host, forwarded', response.headers.get('Vary'));
check('route readiness current', routePayload.readiness.state === 'current', routePayload.readiness.state);
check('route checks len', routePayload.checks.length === 1, routePayload.checks.length);
check('route diagnostics shape', JSON.stringify(routePayload.diagnostics) === JSON.stringify({ summary:'No degraded areas are narrowing the public picture.', affectedAreas:[], healthyAreas:['Weather remains healthy.'] }), routePayload.diagnostics);
check('route safe leakage', "'!/TfL|WeatherAPI|stack|token|secret/i.test(JSON.stringify(routePayload)), routePayload);

