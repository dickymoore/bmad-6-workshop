+  return history.filter((entry) => {
+    const publishedAtMs = Date.parse(entry?.publishedAt ?? "");
+    return !Number.isNaN(publishedAtMs) && nowMs - publishedAtMs <= HISTORY_WINDOW_MS;
+  });
+}
