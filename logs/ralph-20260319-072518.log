+  if (sourceStatus == null) {
+    return createSourceStatus({
+      state: fallbackState,
+    });
+  }
+
+  if (!sourceStatus || typeof sourceStatus !== "object") {
+    throw new Error(`Dashboard source status field "${fieldName}" must be an object`);
+  }
+
+  const { state, label, detail } = sourceStatus;
