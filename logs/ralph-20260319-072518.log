+.ops-page {
+  min-height: 100vh;
+  position: relative;
+  overflow: auto;
+  padding: 28px;
+}
+
+.ops-backdrop {
+  position: absolute;
+  inset: 0;
+  background:
+    radial-gradient(circle at top left, rgba(122, 91, 47, 0.18), transparent 26%),
+    linear-gradient(180deg, rgba(32, 39, 36, 0.03) 0%, rgba(32, 39, 36, 0.12) 100%);
+  pointer-events: none;
+}
+
+.ops-shell {
+  position: relative;
+  z-index: 1;
+  width: 100%;
+  max-width: 1080px;
+  margin-inline: auto;
+  display: grid;
+  gap: 20px;
+}
+
+.ops-shell__skip-link {
+  width: fit-content;
+  padding: 10px 14px;
+  border-radius: 999px;
+  background: rgba(32, 39, 36, 0.92);
+  color: #f7f4ec;
+  text-decoration: none;
+  transform: translateY(-140%);
+}
+
+.ops-shell__skip-link:focus-visible {
+  transform: translateY(0);
+}
+
+.ops-shell__header,
+.ops-panel,
+.ops-action-group {
+  border: 1px solid rgba(122, 91, 47, 0.18);
+  border-radius: 28px;
+  background:
+    linear-gradient(180deg, rgba(255, 252, 246, 0.96) 0%, rgba(249, 242, 231, 0.92) 100%);
+  box-shadow: 0 22px 70px rgba(32, 39, 36, 0.08);
+}
+
+.ops-shell__header,
+.ops-panel {
+  padding: 24px;
+}
+
+.ops-shell__eyebrow,
+.ops-panel__title,
+.ops-action-group__title {
+  margin: 0;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+}
