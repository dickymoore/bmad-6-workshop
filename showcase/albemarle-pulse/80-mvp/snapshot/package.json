{
  "name": "albemarle-pulse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt next dev",
    "build": "NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt next build",
    "start": "NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt next start",
    "start:e2e": "NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt next start --hostname 127.0.0.1 --port 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:smoke && npm run test:unit",
    "test:smoke": "node --test tests/smoke/*.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "screenshot:public-board": "PUBLIC_BOARD_EVIDENCE=1 npm run build && PUBLIC_BOARD_EVIDENCE=1 playwright test tests/e2e/public-board-visual.spec.ts",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "next": "16.1.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.7",
    "typescript": "^5",
    "vitest": "file:tools/vitest-lite"
  }
}
