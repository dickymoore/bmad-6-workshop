+  const nextHistory = pruneHistory(
+    [...existingHistory, createHistoryEntry(normalizedSnapshot)],
+    Date.parse(normalizedSnapshot.publishedAt),
+  );
+
+  await writeStoredDashboardHistory(nextHistory, historyPath);
+  return nextHistory;
+}
