diff --git a/tests/unit/dashboard.presenter.test.mjs b/tests/unit/dashboard.presenter.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..cf00e06e7fd24397dee81be1f3b69b61c1665e9d
