+
+  const trimmed = text.trim();
+
+  if (!trimmed) {
+    return null;
+  }
+
+  const [firstSentence] = trimmed.split(/(?<=[.!?])\s+/);
+
+  if (!firstSentence) {
+    return null;
+  }
+
+  return firstSentence.replace(/[.!?]+$/, "").trim();
+}
+
+function toSentence(text) {
+  const normalized = normalizeSentence(text);
+  return normalized ? `${normalized}.` : null;
+}
+
