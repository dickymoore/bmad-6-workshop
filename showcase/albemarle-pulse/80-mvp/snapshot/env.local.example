# Copy this file to .env.local in the repo root for local development.
# Keep real secrets in .env.local only. Do not commit that file.

# TfL live data
TFL_API_KEY=
TFL_APP_ID=
# Set to 1 only to force a live TfL request attempt even when credentials are blank.
# Leave at 0 for normal local development.
TFL_FORCE_LIVE=0

# Weather live data
WEATHERAPI_KEY=
WEATHERAPI_LOCATION=51.5099,-0.1419
# Set to 1 only to force a live WeatherAPI request attempt even when the key is blank.
# Leave at 0 for normal local development.
WEATHERAPI_FORCE_LIVE=0

# App behavior
DASHBOARD_REFRESH_INTERVAL_MS=30000

# Optional additional hosts allowed to access /ops, comma-separated.
# Loopback hosts are already allowed without setting this.
OPS_ALLOWED_HOSTS=
