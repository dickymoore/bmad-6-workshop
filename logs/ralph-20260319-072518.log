diff --git a/src/lib/client/fetch-json.ts b/src/lib/client/fetch-json.ts
new file mode 100644
index 0000000000000000000000000000000000000000..02399ed113c38b46e05de92fc69c4a83dd0947f7
--- /dev/null
+++ b/src/lib/client/fetch-json.ts
@@ -0,0 +1,16 @@
+export async function fetchJson<T>(input: RequestInfo | URL, init?: RequestInit): Promise<T> {
+  const response = await fetch(input, {
+    ...init,
+    headers: {
+      accept: "application/json",
+      ...(init?.headers ?? {}),
+    },
+    cache: "no-store",
+  });
+
+  if (!response.ok) {
+    throw new Error(`JSON request failed with status ${response.status}`);
+  }
+
+  return (await response.json()) as T;
+}
