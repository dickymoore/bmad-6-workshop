+      },
+      cacheSet(_key, value) {
+        return value;
+      },
+      async readSnapshot() {
+        return storedSnapshot;
+      },
+      async readRecoveryState() {
+        return null;
+      },
+      async recordRestartRecovery({ now }) {
+        const state = {
+          phase: "recovering",
+          recoveredAt: now.toISOString(),
+          recoverySource: "stored-snapshot",
+          livePublicationResumed: false,
+          resumedAt: null,
+        };
+        recordedRecoveryStates.push(state);
+        return state;
