+
+  if (modes.length === 1) {
+    return modes[0].label;
+  }
+
+  if (modes.length === 2) {
+    return `${modes[0].label} and ${modes[1].label}`;
+  }
+
+  return `${modes.slice(0, -1).map((mode) => mode.label).join(", ")}, and ${modes.at(-1).label}`;
