+        throw new Error('Dashboard nearby mode field "nuance" must be a non-empty string when present');
+      }
+
+      return freezeSnapshot({
+        key: key.trim(),
+        label: label.trim(),
+        state,
+        summary: summary.trim(),
+        nuance: typeof nuance === "string" ? nuance.trim() : null,
