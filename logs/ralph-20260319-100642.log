+                  </ul>
+                ) : null}
+
+                {viewModel.healthyAreas.length > 0 ? (
+                  <div className="ops-diagnostics__healthy">
+                    <p className="ops-readiness__label">{viewModel.healthyAreasHeading}</p>
+                    <ul className="ops-readiness__issue-list">
