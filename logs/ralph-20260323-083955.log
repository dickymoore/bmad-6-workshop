+  min-width: 0;
+}
+
+.mode-summary-card {
+  gap: 8px;
+  padding: 14px 16px 14px 20px;
+  border-radius: 18px;
+  background:
+    linear-gradient(180deg, rgba(255, 255, 255, 0.78), rgba(244, 239, 230, 0.94)),
+    rgba(255, 255, 255, 0.74);
+}
+
+.mode-summary-grid__row .mode-summary-card__header {
+  display: grid;
+  gap: 6px;
+  min-width: 0;
+}
+
+.mode-summary-grid__row .mode-summary-card__summary {
+  margin: 0;
+  color: var(--text);
+  font-size: 0.88rem;
+  line-height: 1.3;
+}
+
+.mode-summary-card__label {
+  margin: 0;
+  font-size: 1.08rem;
+}
+
+.mode-summary-card__status {
+  min-width: 104px;
+  align-self: start;
+}
+
+.mode-summary-card__nuance {
+  margin: 0;
+  color: var(--muted);
+  font-size: 0.78rem;
+  line-height: 1.3;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+}
+
+.mode-summary-card__meta {
+  gap: 6px;
+}
+
+.mode-summary-card__meta-chip {
+  padding: 4px 8px;
+  font-size: 0.67rem;
+}
+
+@media (max-height: 820px) {
+  .mode-summary-panel__rows {
+    gap: 8px;
+    margin-top: 12px;
+  }
+
+  .mode-summary-card {
+    padding: 12px 14px 12px 18px;
+  }
+
+  .mode-summary-card__label {
+    font-size: 0.98rem;
+  }
+
+  .mode-summary-grid__row .mode-summary-card__summary,
+  .mode-summary-card__nuance,
+  .mode-summary-card__update {
+    font-size: 0.74rem;
+  }
+}
