   });
 }
 
+/**
+ * @param {{
+ *   actionResult?: {
+ *     action?: string;
+ *     status?: string;
+ *     summary?: string;
+ *     completedAt?: string | null;
+ *     readiness?: {
+ *       label?: string;
+ *       summary?: string;
+ *     };
+ *     attentionDetails?: readonly string[];
