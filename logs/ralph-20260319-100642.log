diff --git a/src/features/ops/ops-shell-view.js b/src/features/ops/ops-shell-view.js
new file mode 100644
index 0000000000000000000000000000000000000000..2dcf0a87c2b201ef995657e8b7d3a99b82ce1f7b
--- /dev/null
+++ b/src/features/ops/ops-shell-view.js
@@ -0,0 +1,32 @@
+export function createOpsShellViewModel(status) {
+  return Object.freeze({
+    readinessHeading: "Public readiness",
+    readinessLabel: status.readiness.label,
+    readinessSummary: status.readiness.summary,
+    snapshotLabel: formatSnapshotState(status.evidence.snapshotState),
+    publishedAt: status.evidence.publishedAt ?? "Not available",
+    checks: status.checks.map((check) =>
+      Object.freeze({
+        ...check,
+        cue: check.status === "pass" ? "OK" : "ATTN",
+      }),
+    ),
+    issuesHeading: "Current ops state",
+    issues:
+      status.issues.length === 0
+        ? Object.freeze(["No active issues are narrowing the public read."])
+        : status.issues,
+  });
+}
+
+function formatSnapshotState(snapshotState) {
+  if (snapshotState === "last-safe") {
+    return "Last safe";
+  }
+
+  if (snapshotState === "fallback") {
+    return "Fallback";
+  }
+
+  return "Live";
+}
diff --git a/src/lib/server/ops/create-ops-health-route-response.js b/src/lib/server/ops/create-ops-health-route-response.js
new file mode 100644
index 0000000000000000000000000000000000000000..5ca8a7669a3a35854c0ba34b450e9d552b5b36d3
--- /dev/null
+++ b/src/lib/server/ops/create-ops-health-route-response.js
@@ -0,0 +1,36 @@
+import { getOpsHealthPayload } from "./get-ops-health.js";
+import { assertOpsAccess, isOpsAccessDeniedError } from "../security/assert-ops-access.js";
+
+/**
+ * @param {{
+ *   requestHeaders?: Headers;
+ *   getOpsHealth?: typeof getOpsHealthPayload;
+ * }} [options]
+ */
+export async function createOpsHealthRouteResponse({
+  requestHeaders,
+  getOpsHealth = getOpsHealthPayload,
+} = {}) {
+  try {
+    assertOpsAccess({
+      headers: requestHeaders,
+    });
+  } catch (error) {
+    if (isOpsAccessDeniedError(error)) {
+      return new Response(null, {
+        status: 404,
+      });
+    }
+
+    throw error;
+  }
+
+  const payload = await getOpsHealth();
+
+  return Response.json(payload, {
+    headers: {
+      "Cache-Control": "no-store, max-age=0",
+      Vary: "host, x-forwarded-host, forwarded",
+    },
+  });
+}
