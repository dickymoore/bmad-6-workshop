+          throw new Error(`Dashboard nearby mode field "${field}" must be a non-empty string`);
+        }
+      }
+
+      if (!NEARBY_MODE_STATES.includes(state)) {
+        throw new Error(`Unsupported nearby mode state: ${state}`);
+      }
