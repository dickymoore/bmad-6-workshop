import { describe, expect, it } from "vitest";
import { renderToStaticMarkup } from "react-dom/server";

import { LocalMapFrame } from "../../src/features/dashboard/components/LocalMapFrame";
import { presentDashboardSnapshot } from "../../src/features/dashboard/presenters/dashboard-presenter.js";
import { createDashboardSnapshot } from "../../src/lib/contracts/dashboard-snapshot.js";

function buildSnapshot() {
  return createDashboardSnapshot({
    overallState: "watchful",
    weatherSummary: "Cold rain is moving across Mayfair and the street is reading a little slower.",
    mobilitySummary: "Nearby departures are still moving, with a tighter rhythm under the rain.",
    placeLabel: "Royal Institution, Albemarle Street",
    freshnessLabel: "Updated moments ago from the current local snapshot.",
    supportLabel: "Weather and mobility reinforce the same local read.",
    localMap: {
      title: "Local frame",
      state: "default",
      venueAnchor: {
        key: "royal-institution",
        label: "Royal Institution",
        x: 48,
        y: 58,
      },
      selectedNearbyNodes: [
        {
          key: "green-park",
          label: "Green Park",
          x: 64,
          y: 32,
        },
      ],
      localityEmphasis: {
        label: "Piccadilly and Green Park remain the clearest local corridor.",
      },
      fallbackCopy: null,
    },
    nearbyModes: [
      {
        key: "tube-rail",
        label: "Tube and rail",
        state: "available",
        summary: "Green Park and Piccadilly lines are still reading open nearby.",
        nuance: null,
      },
    ],
  });
}

describe("local map frame", () => {
  it("renders the fallback explanation in the intro and simplifies the graphic treatment", () => {
    const defaultViewModel = presentDashboardSnapshot(buildSnapshot()).localMap;
    const fallbackViewModel = presentDashboardSnapshot(
      createDashboardSnapshot({
        ...buildSnapshot(),
        localMap: {
          ...buildSnapshot().localMap,
          state: "fallback",
          localityEmphasis: {
            label: "This should not replace the fallback explanation.",
          },
          fallbackCopy: "Simplified local frame while richer locality detail is unavailable.",
        },
      }),
    ).localMap;

    const defaultMarkup = renderToStaticMarkup(<LocalMapFrame viewModel={defaultViewModel} />);
    const fallbackMarkup = renderToStaticMarkup(<LocalMapFrame viewModel={fallbackViewModel} />);

    expect(defaultMarkup).toContain("Piccadilly and Green Park remain the clearest local corridor.");
    expect(defaultMarkup).toContain("local-map-panel__corridor");
    expect(fallbackMarkup).toContain("Simplified local frame while richer locality detail is unavailable.");
    expect(fallbackMarkup).not.toContain("This should not replace the fallback explanation.");
    expect(fallbackMarkup).not.toContain("local-map-panel__corridor");
  });
});
