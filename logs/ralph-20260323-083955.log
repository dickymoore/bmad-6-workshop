+function normalizeLocalityReference(reference, fieldName) {
+  if (!reference || typeof reference !== "object") {
+    throw new Error(`Dashboard locality field "${fieldName}" must be an object`);
+  }
+
+  const { key, label, kind, caption } = reference;
+
