+export async function getLatestAvailableDashboardApiResponse({
+  now = new Date(),
+  refreshIntervalMs = Number(process.env.DASHBOARD_REFRESH_INTERVAL_MS ?? DEFAULT_REFRESH_INTERVAL_MS),
+  cacheGet = getMemoryCacheEntry,
