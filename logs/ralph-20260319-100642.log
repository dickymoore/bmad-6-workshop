+    resumedAt: null,
+  };
   const checks = CHECK_DEFINITIONS.map((definition) => createCheck(definition, snapshot));
   const issues = createIssues(snapshot, snapshotState, checks);
   const diagnostics = createDegradedImpactDiagnostics({ dashboardResponse });
@@ -165,6 +184,15 @@
