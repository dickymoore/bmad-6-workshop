+    throw new Error(`Unsupported dashboard locality kind for "${fieldName}": ${kind}`);
+  }
+
+  return freezeSnapshot({
+    key: key.trim(),
+    label: label.trim(),
+    kind,
+    caption: caption.trim(),
+  });
