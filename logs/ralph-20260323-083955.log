+
+  const sentence = normalizeSentence(mode.summary);
+
+  if (!sentence) {
+    return mode.summary;
+  }
+
+  return `${sentence
+    .replace(/\bstill\b/gi, "")
+    .replace(/\s{2,}/g, " ")
+    .trim()}.`;
