+function formatAffectedModeLabels(modes) {
+  if (modes.length === 0) {
+    return "";
+  }
+
+  if (modes.length === 1) {
+    return modes[0].label;
+  }
+
+  if (modes.length === 2) {
+    return `${modes[0].label} and ${modes[1].label}`;
+  }
