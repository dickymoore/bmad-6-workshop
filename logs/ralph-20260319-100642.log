diff --git a/tests/unit/ops-maintenance-action.test.mjs b/tests/unit/ops-maintenance-action.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..60610971fccd06f18b7c041ce4bfa5e42aee11dc
