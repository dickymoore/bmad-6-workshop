+
+  if (supportFragments.length > 0) {
+    return `${supportFragments.join(". ")}.`;
+  }
+
+  if (mode.disruptionScope !== "unaffected-readable") {
+    return toSentence(mode.nuance);
+  }
+
+  return null;
+}
